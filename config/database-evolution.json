{
  "schemaVersion": "database.evolution.config.v1",
  "repository": "Gakulllka/ai-database",
  "branch": "database",
  "repositoryVisibility": "public",
  "mode": "reviewed-direct",
  "execution": {
    "runtime": "local-codex",
    "separateModelApiRequired": false,
    "schedule": "daily at 04:00 Europe/Moscow",
    "maxMinutesPerRun": 30,
    "maxDeepReviews": 3
  },
  "radar": {
    "queries": [
      "topic:ai-agents archived:false fork:false",
      "topic:llm created:>={{since}} stars:>=20 archived:false fork:false",
      "topic:mcp-server created:>={{since}} stars:>=10 archived:false fork:false",
      "\"agent harness\" in:name,description created:>={{since}} archived:false fork:false"
    ],
    "windowDays": 90,
    "minTrendHours": 6,
    "maxCandidates": 20,
    "perQuery": 10,
    "timeoutMs": 15000,
    "maxInventoryFiles": 2500,
    "statePath": "docs/evolution/github-observations.json"
  },
  "policy": {
    "maxSkillChanges": 3,
    "maxChangedFiles": 12,
    "maxChangedLines": 500,
    "automaticScope": "Verified reusable Database improvements, including existing/new skills and necessary supporting code, rules, roles, registration and configuration; direct normal push after independent review and affected checks. Consumer data and environment permission bypasses remain excluded.",
    "requireIndependentReview": true,
    "requireMeaningfulEvidence": true,
    "newSkillsRequirePullRequest": false,
    "executableChangesRequirePullRequest": false,
    "permissionChangesRequirePullRequest": false,
    "scopeClassificationsRequireCompleteReview": true,
    "allowForcePush": false,
    "allowUntrustedCodeExecution": false
  },
  "learning": {
    "store": "ECC Memory Vault team lessons",
    "scope": "team",
    "kind": "lesson",
    "rawTranscriptsAllowed": false,
    "projectSpecificRulesRemainLocal": true,
    "proposalPublication": "reviewed direct push of verified sanitized lessons; defer unproven lessons locally",
    "deduplication": "source revision, capability and evidence; cross-PC paths are not identity"
  }
}
